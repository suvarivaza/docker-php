COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml
COMPOSE_PROFILES=dev

# The project name must be unique in your docker environment!
COMPOSE_PROJECT_NAME=myproject

# Path from docker folder to project root
APP_PATH=../src

# Домен сайта
APP_URL=myproject.local

# PHP
# can be nginx/apache
PHP_WEBSERVER=apache
PHP_VERSION=7.4
PHP_PORT=81

# Database
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=database
DB_USERNAME=dbuser
DB_PASSWORD=dbpassword
MYSQL_ROOT_PASSWORD=dbrootpassword

#phpmyadmin
PMA_PORT=8080

# for downloading db/files from remote host
#SSH=root@123.456.78.90
#SSH_DB_USER=dbuser
#SSH_DB_NAME=dbpassword