COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
COMPOSE_PROFILES=prod

# The project name must be unique in your docker environment!
COMPOSE_PROJECT_NAME=myproject

# Path from docker folder to project root
APP_PATH=../src

APP_URL=myproject.com

# PHP
# can be nginx/apache
PHP_WEBSERVER=apache
PHP_VERSION=7.4

# Database
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=database
DB_USERNAME=dbuser
DB_PASSWORD=dbpassword
MYSQL_ROOT_PASSWORD=dbrootpassword

# Traefik
TRAEFIK_DOMAIN_EMAIL=admin@yourdomain.com

# Access to Traefik dashboard
# generate: htpasswd -nbB user yourpassword
TRAEFIK_AUTH=user:hashedpassword

# Access to phpmyadmin
# generate: htpasswd -nbB user yourpassword
TRAEFIK_AUTH_PMA=user:hashedpassword

# if not specified, the service will be available from all addresses
#ALLOWED_IP_PMA=
